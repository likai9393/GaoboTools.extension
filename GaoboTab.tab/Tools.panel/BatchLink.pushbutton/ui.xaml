<Window xmlns="http://schemas.microsoft.com/winfx/2000/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2000/xaml"
        Title="高级批量链接管理器" Height="520" Width="620" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <TabControl>
            <TabItem Header=" RVT 模型链接 ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="当前项目中的 RVT 链接列表（支持多选）：" Margin="0,0,0,5" FontWeight="Bold"/>
                    <ListBox x:Name="RvtListBox" Grid.Row="1" SelectionMode="Multiple" DisplayMemberPath="Name"/>
                    
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="新链接对齐方式: " VerticalAlignment="Center"/>
                            <ComboBox x:Name="RvtPosCombo" Width="140" Height="25" Margin="5,0,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="自动 - 原点到原点"/>
                                <ComboBoxItem Content="自动 - 通过共享坐标"/>
                                <ComboBoxItem Content="手动 - 中心"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnReloadRvt" Content="批量重新载入" Width="100" Height="30" Margin="5,0"/>
                            <Button x:Name="BtnUnloadRvt" Content="批量卸载" Width="100" Height="30" Margin="5,0"/>
                            <Button x:Name="BtnAddRvt" Content="+ 批量添加" Width="100" Height="30" Margin="5,0" Background="#E1F5FE" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header=" DWG 图纸链接 ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="当前项目中的 DWG 链接列表（支持多选）：" Margin="0,0,0,5" FontWeight="Bold"/>
                    <ListBox x:Name="DwgListBox" Grid.Row="1" SelectionMode="Multiple" DisplayMemberPath="Name"/>
                    
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="新链接对齐方式: " VerticalAlignment="Center"/>
                            <ComboBox x:Name="DwgPosCombo" Width="140" Height="25" Margin="5,0,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="自动 - 原点到原点"/>
                                <ComboBoxItem Content="自动 - 共享坐标"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnReloadDwg" Content="批量重新载入" Width="100" Height="30" Margin="5,0"/>
                            <Button x:Name="BtnUnloadDwg" Content="批量卸载" Width="100" Height="30" Margin="5,0"/>
                            <Button x:Name="BtnAddDwg" Content="+ 批量添加" Width="100" Height="30" Margin="5,0" Background="#E1F5FE" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>