<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="坐标提取与DWG投影工具" Height="320" Width="380" MinHeight="280" MinWidth="340"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        MouseLeftButtonDown="OnWindowDrag">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 动作按钮 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <Button Name="btnSelection" Content="手动框选元素" Width="140" Height="35" Margin="0,0,20,0" Click="OnSelectClick"/>
            <Button Name="btnAll" Content="全选项目元素" Width="140" Height="35" Click="OnAllClick"/>
        </StackPanel>

        <!-- DWG 选择区标题 -->
        <TextBlock Grid.Row="1" Text="投影目标 DWG 链接模型列表:" FontWeight="Bold" Margin="0,5,0,5"/>
        
        <!-- DWG 列表 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <ListBox Name="lstDwgs" DisplayMemberPath="Name" Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <Button Content="添加DWG" Height="28" Margin="0,0,0,8" Click="OnAddDwg"/>
                <Button Content="移出列表" Height="28" Click="OnRemoveDwg"/>
            </StackPanel>
        </Grid>
        
        <TextBlock Grid.Row="3" Text="*提示: 投影失败的点将保持原Z值不变" Foreground="Gray" FontSize="11" Margin="0,10,0,0"/>
    </Grid>
</Window>
