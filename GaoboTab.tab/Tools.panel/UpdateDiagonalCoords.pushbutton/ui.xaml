<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="对角线三点坐标提取与DWG投影工具" Height="420" Width="380" MinHeight="350" MinWidth="340"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        MouseLeftButtonDown="OnWindowDrag">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 动作按钮 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Name="btnSelection" Content="手动框选元素" Width="140" Height="30" Margin="0,0,15,0" Click="OnSelectClick"/>
            <Button Name="btnAll" Content="全选项目元素" Width="140" Height="30" Click="OnAllClick"/>
        </StackPanel>

        <!-- 轮廓线选择按钮（支持框选） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <Button Name="btnPickOutline" Content="框选航站楼轮廓线" Width="295" Height="30" Click="OnPickOutlineClick"/>
        </StackPanel>

        <!-- DWG 选择区标题 -->
        <TextBlock Grid.Row="2" Text="投影目标 DWG 链接模型列表:" FontWeight="Bold" Margin="0,5,0,5"/>

        <!-- DWG 列表 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <ListBox Name="lstDwgs" DisplayMemberPath="Name" Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <Button Content="添加DWG" Height="28" Margin="0,0,0,8" Click="OnAddDwg"/>
                <Button Content="移出列表" Height="28" Click="OnRemoveDwg"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="4" Text="*提示: 起点/终点基于轮廓线距离与切线方向自动分清 C1(近端) 与 C2(远端)"
                   Foreground="Gray" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="5" Name="txt_status" Text="就绪。请先框选轮廓线和DWG，再处理元素。"
                   Foreground="DarkSlateGray" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>